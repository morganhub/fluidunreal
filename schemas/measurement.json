{
  "$id": "https://fluidunreal.local/schemas/measurement.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "additionalProperties": true,
      "title": "Detail",
      "type": "object"
    },
    "expected": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected"
    },
    "kind": {
      "enum": [
        "scale_check",
        "axis_check",
        "anim_length",
        "root_motion_travel",
        "socket_position",
        "bone_count",
        "rendered_share"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "description": "What was measured, e.g. the bone",
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "observed": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed"
    },
    "passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None means it could not be measured: never a pass, never a failure",
      "title": "Passed"
    },
    "space": {
      "default": "world",
      "enum": [
        "world",
        "component",
        "local",
        "frame",
        "none"
      ],
      "title": "Space",
      "type": "string"
    },
    "tolerance": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tolerance"
    },
    "unit": {
      "default": "cm",
      "enum": [
        "cm",
        "m",
        "frames",
        "seconds",
        "count",
        "share"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "title": "Measurement",
  "type": "object"
}
