{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "MISSING_DEPENDENCY",
        "UNSUPPORTED_CAPABILITY",
        "RIG_MAPPING_REQUIRED",
        "SCENE_CONFLICT",
        "PERMISSION_REQUIRED",
        "BUDGET_EXCEEDED",
        "TIMEOUT_UNKNOWN_STATE",
        "VALIDATION_FAILED",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorRecord": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recovery": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorRecord",
      "type": "object"
    },
    "Estimate": {
      "additionalProperties": false,
      "description": "What a run is expected to cost before it starts.",
      "properties": {
        "checked_before_execution": {
          "description": "False for a host operation: nothing is refused on this estimate",
          "title": "Checked Before Execution",
          "type": "boolean"
        },
        "free_disk_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None when it was not measured",
          "title": "Free Disk Bytes"
        },
        "minutes": {
          "minimum": 0,
          "title": "Minutes",
          "type": "number"
        },
        "new_disk_bytes": {
          "minimum": 0,
          "title": "New Disk Bytes",
          "type": "integer"
        },
        "run_seconds": {
          "minimum": 0,
          "title": "Run Seconds",
          "type": "number"
        },
        "seconds": {
          "description": "run_seconds + startup_seconds",
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "sources": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "For each number above, where it came from",
          "title": "Sources",
          "type": "object"
        },
        "startup_seconds": {
          "description": "Opening the project, before any Python runs",
          "minimum": 0,
          "title": "Startup Seconds",
          "type": "number"
        }
      },
      "required": [
        "seconds",
        "minutes",
        "run_seconds",
        "startup_seconds",
        "new_disk_bytes",
        "checked_before_execution",
        "sources"
      ],
      "title": "Estimate",
      "type": "object"
    }
  },
  "$id": "https://fluidunreal.local/schemas/plan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available": {
      "title": "Available",
      "type": "boolean"
    },
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "blocking_errors": {
      "items": {
        "$ref": "#/$defs/ErrorRecord"
      },
      "title": "Blocking Errors",
      "type": "array"
    },
    "budget": {
      "additionalProperties": true,
      "title": "Budget",
      "type": "object"
    },
    "estimate": {
      "$ref": "#/$defs/Estimate"
    },
    "estimated_new_disk_mib": {
      "minimum": 0,
      "title": "Estimated New Disk Mib",
      "type": "number"
    },
    "estimated_seconds": {
      "minimum": 0,
      "title": "Estimated Seconds",
      "type": "number"
    },
    "lot": {
      "title": "Lot",
      "type": "string"
    },
    "op_class": {
      "title": "Op Class",
      "type": "string"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "permission_ok": {
      "title": "Permission Ok",
      "type": "boolean"
    },
    "resources": {
      "items": {
        "type": "string"
      },
      "title": "Resources",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "type": "string"
      },
      "title": "Steps",
      "type": "array"
    },
    "stop_conditions": {
      "items": {
        "type": "string"
      },
      "title": "Stop Conditions",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "within_budget",
        "over_budget",
        "blocked"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "operation_id",
    "operation",
    "backend",
    "op_class",
    "lot",
    "available",
    "permission_ok",
    "estimated_seconds",
    "estimated_new_disk_mib",
    "estimate",
    "verdict"
  ],
  "title": "Plan",
  "type": "object"
}
