  "properties": {
    "dependencies": {
      "additionalProperties": {
        "$ref": "#/$defs/DependencyEntry"
      },
      "title": "Dependencies",
      "type": "object"
    },
    "extra": {
      "additionalProperties": true,
      "title": "Extra",
      "type": "object"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "DependencyLock",
  "type": "object"
}
