      "required": [
        "name"
      ],
      "title": "DependencyEntry",
      "type": "object"
    }
  },
  "$id": "https://fluidunreal.local/schemas/dependencies-lock.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
