{
  "$defs": {
    "Autonomy": {
      "additionalProperties": false,
      "properties": {
        "approval_record": {
          "default": "state/approvals/project-scope.json",
          "title": "Approval Record",
          "type": "string"
        },
        "max_repair_attempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Repair Attempts",
          "type": "integer"
        },
        "mode": {
          "default": "assisted",
          "enum": [
            "inspect",
            "assisted",
            "local_autonomous",
            "batch_approved"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Autonomy",
      "type": "object"
    },
    "Sources": {
      "additionalProperties": false,
      "description": "Where the bundles come from. Read to phrase exact commands, never written to.",
      "properties": {
        "fluidblend_project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Absolute path to the sibling project, for next_safe_actions only",
          "title": "Fluidblend Project"
        }
      },
      "title": "Sources",
      "type": "object"
    },
    "UnrealBudgets": {
      "additionalProperties": false,
      "description": "Same shape as fluidblend's, with defaults sized for an engine that compiles shaders.",
      "properties": {
        "max_external_spend": {
          "default": 0.0,
          "minimum": 0,
          "title": "Max External Spend",
          "type": "number"
        },
        "max_new_disk_gib": {
          "default": 20.0,
          "maximum": 10000,
          "minimum": 0.01,
          "title": "Max New Disk Gib",
          "type": "number"
        },
        "max_preview_frames": {
          "default": 240,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Preview Frames",
          "type": "integer"
        },
        "max_task_minutes": {
          "default": 45,
          "maximum": 1440,
          "minimum": 1,
          "title": "Max Task Minutes",
          "type": "integer"
        }
      },
      "title": "UnrealBudgets",
      "type": "object"
    },
    "UnrealSection": {
      "additionalProperties": false,
      "properties": {
        "content_root": {
          "default": "Content/Fluid",
          "description": "The only place under Content/ this kit ever writes",
          "title": "Content Root",
          "type": "string"
        },
        "engine_series": {
          "default": "5.8",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Engine Series",
          "type": "string"
        },
        "uproject": {
          "description": "Project-relative path to the .uproject, or an absolute one for an existing project the user already has",
          "minLength": 1,
          "title": "Uproject",
          "type": "string"
        }
      },
      "required": [
        "uproject"
      ],
      "title": "UnrealSection",
      "type": "object"
    }
  },
  "$id": "https://fluidunreal.local/schemas/project.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "autonomy": {
      "$ref": "#/$defs/Autonomy"
    },
    "budgets": {
      "$ref": "#/$defs/UnrealBudgets"
    },
    "created_at": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "dependency_lock": {
      "default": "dependencies.lock.json",
      "title": "Dependency Lock",
      "type": "string"
    },
    "fluidunreal_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Fluidunreal Version",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "profile": {
      "const": "unreal",
      "default": "unreal",
      "title": "Profile",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    },
    "ue": {
      "$ref": "#/$defs/UnrealSection"
    }
  },
  "required": [
    "project_id",
    "name",
    "ue",
    "created_at",
    "fluidunreal_version"
  ],
  "title": "ProjectManifest",
  "type": "object"
}
