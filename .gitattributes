# Line endings: LF everywhere, CRLF for PowerShell scripts.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal text assets stay text; its binary assets go through Git LFS.
*.uproject text eol=lf
*.ini text eol=lf

*.glb filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
