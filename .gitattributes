# Line endings: LF everywhere, CRLF for PowerShell scripts.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal text assets stay text; its binary assets go through Git LFS.
# Pinned by sha256: git must never normalise these, or the hash a checkout produces differs from
# the one that was recorded. Same reason fluidblend marks its vendored Three.js `-text`.
templates/game-unreal/** -text

# A bundle is pinned by the sha256 in its own manifest. Normalising its text files makes a checkout
# hash differently from what the manifest records, and bundle.accept then refuses the fixture.
fixtures/** -text

*.glb filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
